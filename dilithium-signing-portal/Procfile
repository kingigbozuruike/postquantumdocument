# Procfile for Railway, Render, and other platforms
# Specifies how to build and run the application

# Web process: Start the backend server
# LD_LIBRARY_PATH points to the liboqs library built during the build phase
web: cd backend && LD_LIBRARY_PATH=/app/.oqs/lib:$LD_LIBRARY_PATH source venv/bin/activate && python main.py

# Worker process: Run benchmarks (optional)
# worker: cd backend && source venv/bin/activate && python benchmark.py
